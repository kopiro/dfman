#!/bin/bash

set -e

CONFIG_FILE="$HOME/.config/dfman.conf"
DFMAN_UPDATE_URL="https://raw.githubusercontent.com/kopiro/dfman/main/dfman"
CONFIG_SOURCES=()
CONFIG_TARGETS=()

usage() {
    echo "Usage: dfman <create|link|doctor|repo-add|repo-rm|repo-sync|sync|status|shell|self-update> [options]"
    echo ""
    echo "Config:"
    echo "  $CONFIG_FILE"
    echo ""
    echo "Commands:"
    echo "  link [-f] [-v] [--dry-run] [--repo r] Symlink dotfiles to target directory"
    echo "  create --repo r path Import a file into dotfiles"
    echo "  doctor [--repo repo] Find broken symlinks"
    echo "  repo-add <src> [tgt] Add a source to the config"
    echo "  repo-rm <source>     Remove a source from the config"
    echo "  repo-sync [--reset] [--repo r] [--ssh-key k] Commit, pull, and push repos"
    echo "  sync [--reset] [--repo r] [--ssh-key k]      Alias of repo-sync"
    echo "  status [--ack]       Show scheduled sync results and recovery notices"
    echo "  shell <install|uninstall|status>  Manage terminal notices (zsh)"
    echo "  self-update [--check] Update dfman or check without installing"
    exit 1
}

expand_home() {
    local path="$1"

    # Accept native Windows paths from cmd/PowerShell as well as Git Bash paths.
    case "${OSTYPE:-}" in
        msys*|cygwin*)
            path="${path//\\//}"
            if [[ "$path" == [a-zA-Z]:/* ]] || [[ "$path" == //* ]]; then
                path=$(cygpath -u "$path")
            fi
            ;;
    esac

    case "$path" in
        "~")
            echo "$HOME"
            ;;
        "~/"*)
            echo "$HOME/${path#\~/}"
            ;;
        "$HOME/~")
            echo "$HOME"
            ;;
        "$HOME/~/"*)
            # If a caller or existing config accidentally produced "$HOME/~/x",
            # treat it as "~/x" instead of looking for a literal "~" directory.
            echo "$HOME/${path#"$HOME/~/"}"
            ;;
        *)
            echo "$path"
            ;;
    esac
}

normalize_dir() {
    local dir="$1"

    # Keep root as "/" but remove trailing slashes elsewhere so target prefix
    # matching behaves consistently for paths from the config file.
    while [ "$dir" != "/" ] && [ "${dir%/}" != "$dir" ]; do
        dir="${dir%/}"
    done

    echo "$dir"
}

validate_config_path() {
    local path="$1"
    local kind="$2"
    local location="$3"

    if [[ "$path" != /* ]]; then
        echo "Error: $kind must be absolute or start with ~ in $location"
        exit 1
    fi
}

validate_config_value() {
    local value="$1"
    local kind="$2"

    # Config entries are whitespace-delimited and use # for comments. Rejecting
    # those characters keeps repo-add from writing lines dfman cannot read back.
    if [[ "$value" =~ [[:space:]] ]] || [[ "$value" == *"#"* ]]; then
        echo "Error: $kind cannot contain whitespace or #"
        exit 1
    fi
}

log_success() {
    printf '\033[32m%s\033[0m\n' "$*"
}

log_warning() {
    printf '\033[33mWarning: %s\033[0m\n' "$*"
}

log_blocked() {
    printf '\033[31m%s\033[0m\n' "$*"
}

repo_sync_usage() {
    echo "Usage: dfman repo-sync [--reset] [--repo <source>] [--ssh-key <path>]"
}

current_executable_path() {
    local script_path="${1:-${BASH_SOURCE[0]}}"

    script_path=$(expand_home "$script_path")

    if [[ "$script_path" != */* ]]; then
        script_path=$(command -v "$script_path")
    fi

    if [[ "$script_path" != /* ]]; then
        script_path="$(pwd)/$script_path"
    fi

    # Follow symlinks so self-update refreshes the actual installed script,
    # not just the launcher path used to invoke it.
    while [ -L "$script_path" ]; do
        local link_target
        link_target=$(readlink "$script_path")

        if [[ "$link_target" == /* ]]; then
            script_path="$link_target"
        else
            script_path="$(cd "$(dirname "$script_path")" && pwd)/$link_target"
        fi
    done

    local script_dir
    script_dir=$(cd "$(dirname "$script_path")" && pwd) || return 1

    echo "$script_dir/$(basename "$script_path")"
}

load_config() {
    CONFIG_SOURCES=()
    CONFIG_TARGETS=()

    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Error: config file not found: $CONFIG_FILE"
        exit 1
    fi

    local line
    local line_number=0
    local source_dir
    local target_dir
    local extra

    while IFS= read -r line || [ -n "$line" ]; do
        line_number=$((line_number + 1))

        # The config is intentionally line-oriented to keep dfman dependency
        # free. Each non-comment line is: source [target].
        line="${line%%#*}"
        read -r source_dir target_dir extra <<< "$line"

        if [ -z "$source_dir" ]; then
            continue
        fi

        if [ -n "$extra" ]; then
            echo "Error: too many fields in $CONFIG_FILE:$line_number"
            exit 1
        fi

        if [ -z "$target_dir" ]; then
            target_dir="~"
        fi

        source_dir=$(normalize_dir "$(expand_home "$source_dir")")
        target_dir=$(normalize_dir "$(expand_home "$target_dir")")

        validate_config_path "$source_dir" "source" "$CONFIG_FILE:$line_number"
        validate_config_path "$target_dir" "target" "$CONFIG_FILE:$line_number"

        CONFIG_SOURCES+=("$source_dir")
        CONFIG_TARGETS+=("$target_dir")
    done < "$CONFIG_FILE"

    if [ "${#CONFIG_SOURCES[@]}" -eq 0 ]; then
        echo "Error: config file must define at least one source"
        exit 1
    fi
}

config_entry_exists() {
    local source_to_add="$1"
    local target_to_add="$2"

    if [ ! -f "$CONFIG_FILE" ]; then
        return 1
    fi

    local line
    local line_number=0
    local source_dir
    local target_dir
    local extra

    while IFS= read -r line || [ -n "$line" ]; do
        line_number=$((line_number + 1))
        line="${line%%#*}"
        read -r source_dir target_dir extra <<< "$line"

        if [ -z "$source_dir" ]; then
            continue
        fi

        if [ -n "$extra" ]; then
            echo "Error: too many fields in $CONFIG_FILE:$line_number"
            exit 1
        fi

        if [ -z "$target_dir" ]; then
            target_dir="~"
        fi

        source_dir=$(normalize_dir "$(expand_home "$source_dir")")
        target_dir=$(normalize_dir "$(expand_home "$target_dir")")

        validate_config_path "$source_dir" "source" "$CONFIG_FILE:$line_number"
        validate_config_path "$target_dir" "target" "$CONFIG_FILE:$line_number"

        if [ "$source_dir" = "$source_to_add" ] && [ "$target_dir" = "$target_to_add" ]; then
            return 0
        fi
    done < "$CONFIG_FILE"

    return 1
}

require_source_exists() {
    local source_dir="$1"

    if [ ! -d "$source_dir" ]; then
        echo "Error: source directory does not exist: $source_dir"
        exit 1
    fi
}

require_all_sources_exist() {
    local source_dir

    for source_dir in "${CONFIG_SOURCES[@]}"; do
        require_source_exists "$source_dir"
    done
}

path_is_under_target() {
    local full_path="$1"
    local target_dir="$2"

    if [ "$target_dir" = "/" ]; then
        [[ "$full_path" == /* ]]
    else
        [[ "$full_path" == "$target_dir"/* ]]
    fi
}

relative_path_from_target() {
    local full_path="$1"
    local target_dir="$2"

    if [ "$target_dir" = "/" ]; then
        echo "${full_path#/}"
    else
        echo "${full_path#$target_dir/}"
    fi
}

select_config_for_repo() {
    local repo_arg="$1"
    local repo_dir
    local index

    repo_dir=$(normalize_dir "$(expand_home "$repo_arg")")
    validate_config_path "$repo_dir" "repo" "repo argument"

    SELECTED_SOURCE_DIR=""
    SELECTED_TARGET_DIR=""

    for index in "${!CONFIG_SOURCES[@]}"; do
        if [ "${CONFIG_SOURCES[$index]}" = "$repo_dir" ]; then
            SELECTED_SOURCE_DIR="${CONFIG_SOURCES[$index]}"
            SELECTED_TARGET_DIR="${CONFIG_TARGETS[$index]}"
            return
        fi
    done

    echo "Error: repo is not configured: $repo_arg"
    exit 1
}

link_source() {
    local source_dir="$1"
    local target_dir="$2"
    local force="$3"
    local dry_run="$4"
    local verbose="$5"

    echo "Linking source: $source_dir -> $target_dir"

    find "$source_dir" -mindepth 1 -maxdepth 1 | while read -r dotfile; do
        relative_path="${dotfile#$source_dir/}"

        # Handle files with # in name (treat as directory separator)
        if [[ "$relative_path" == *"#"* ]]; then
            target_path="${relative_path//#//}"
            symlink_target="$target_dir/$target_path"

            target_parent_dir=$(dirname "$symlink_target")
            if [ "$dry_run" = true ]; then
                echo "Would create directory: $target_parent_dir"
            else
                mkdir -p "$target_parent_dir"
            fi
        else
            symlink_target="$target_dir/$relative_path"
        fi

        # Skip if already a symlink
        if [ -L "$symlink_target" ]; then
            current_target=$(readlink "$symlink_target")
            if [ "$current_target" != "$dotfile" ]; then
                log_warning "$symlink_target already points to $current_target, expected $dotfile"
                if [ "$force" = true ]; then
                    if [ "$dry_run" = true ]; then
                        echo "Would remove symlink: $symlink_target"
                        echo "Would link: $dotfile -> $symlink_target"
                        continue
                    fi

                    read -p "Delete and replace? [y/N] " confirm < /dev/tty
                    if [[ "$confirm" =~ ^[Yy]$ ]]; then
                        echo "Removing symlink: $symlink_target"
                        rm "$symlink_target"
                    else
                        log_blocked "Skipped: $symlink_target already points to $current_target"
                        continue
                    fi
                else
                    continue
                fi
            else
                if [ "$verbose" = true ]; then
                    log_success "OK: $symlink_target -> $dotfile"
                fi
                continue
            fi
        fi

        if [ -d "$symlink_target" ]; then
            log_warning "$symlink_target already exists as a directory"
            if [ "$force" = true ]; then
                if [ "$dry_run" = true ]; then
                    echo "Would remove directory: $symlink_target"
                    echo "Would link: $dotfile -> $symlink_target"
                    continue
                fi

                read -p "Delete and replace? [y/N] " confirm < /dev/tty
                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    echo "Removing directory: $symlink_target"
                    rm -rf "$symlink_target"
                else
                    log_blocked "Skipped: $symlink_target is a directory"
                    continue
                fi
            else
                log_blocked "Skipped: $symlink_target is a directory"
                continue
            fi
        fi

        if [ -f "$symlink_target" ]; then
            log_warning "$symlink_target already exists as a file"
            if [ "$force" = true ]; then
                if [ "$dry_run" = true ]; then
                    echo "Would remove file: $symlink_target"
                    echo "Would link: $dotfile -> $symlink_target"
                    continue
                fi

                read -p "Delete and replace? [y/N] " confirm < /dev/tty
                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    echo "Removing file: $symlink_target"
                    rm "$symlink_target"
                else
                    log_blocked "Skipped: $symlink_target is a file"
                    continue
                fi
            else
                log_blocked "Skipped: $symlink_target is a file"
                continue
            fi
        fi

        if [ "$dry_run" = true ]; then
            echo "Would link: $dotfile -> $symlink_target"
        else
            echo "Linking: $dotfile -> $symlink_target"
            # Git Bash otherwise silently copies files instead of linking them.
            # Fail if native symlinks are unavailable; never leave stale copies.
            case "${OSTYPE:-}" in
                msys*|cygwin*)
                    MSYS="${MSYS:+$MSYS }winsymlinks:nativestrict" \
                    CYGWIN="${CYGWIN:+$CYGWIN }winsymlinks:nativestrict" \
                        ln -s "$dotfile" "$symlink_target"
                    ;;
                *) ln -s "$dotfile" "$symlink_target" ;;
            esac
        fi
    done
}

cmd_link() {
    FORCE=false
    DRY_RUN=false
    VERBOSE=false
    local repo_arg=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f)
                FORCE=true
                shift
                ;;
            -v)
                VERBOSE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --repo)
                if [ -z "${2:-}" ]; then
                    echo "Usage: dfman link [-f] [-v] [--dry-run] [--repo <source>]"
                    exit 1
                fi
                repo_arg="$2"
                shift 2
                ;;
            --repo=*)
                repo_arg="${1#--repo=}"
                if [ -z "$repo_arg" ]; then
                    echo "Usage: dfman link [-f] [-v] [--dry-run] [--repo <source>]"
                    exit 1
                fi
                shift
                ;;
            *)
                echo "Usage: dfman link [-f] [-v] [--dry-run] [--repo <source>]"
                exit 1
                ;;
        esac
    done

    if [ "$FORCE" = true ]; then
        echo "Force mode enabled"
    fi

    if [ "$DRY_RUN" = true ]; then
        echo "Dry run enabled"
    fi

    load_config
    if [ -n "$repo_arg" ]; then
        select_config_for_repo "$repo_arg"
        require_source_exists "$SELECTED_SOURCE_DIR"
        link_source "$SELECTED_SOURCE_DIR" "$SELECTED_TARGET_DIR" "$FORCE" "$DRY_RUN" "$VERBOSE"
    else
        require_all_sources_exist

        local index
        for index in "${!CONFIG_SOURCES[@]}"; do
            link_source "${CONFIG_SOURCES[$index]}" "${CONFIG_TARGETS[$index]}" "$FORCE" "$DRY_RUN" "$VERBOSE"
        done
    fi

    if [ "$DRY_RUN" = true ]; then
        echo "Dry run completed"
    else
        echo "Dotfiles linked successfully"
    fi
}

cmd_create() {
    local repo_arg=""
    local full_path=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)
                if [ -z "${2:-}" ]; then
                    echo "Usage: dfman create --repo <source> <absolute-path>"
                    exit 1
                fi
                repo_arg="$2"
                shift 2
                ;;
            --repo=*)
                repo_arg="${1#--repo=}"
                if [ -z "$repo_arg" ]; then
                    echo "Usage: dfman create --repo <source> <absolute-path>"
                    exit 1
                fi
                shift
                ;;
            --*)
                echo "Usage: dfman create --repo <source> <absolute-path>"
                exit 1
                ;;
            *)
                if [ -n "$full_path" ]; then
                    echo "Usage: dfman create --repo <source> <absolute-path>"
                    exit 1
                fi
                full_path="$1"
                shift
                ;;
        esac
    done

    if [ -z "$repo_arg" ] || [ -z "$full_path" ]; then
        echo "Usage: dfman create --repo <source> <absolute-path>"
        exit 1
    fi

    full_path=$(expand_home "$full_path")
    if [[ "$full_path" != /* ]]; then
        echo "Error: path must be absolute"
        exit 1
    fi

    if [ ! -e "$full_path" ]; then
        echo "Error: $full_path does not exist"
        exit 1
    fi

    load_config
    select_config_for_repo "$repo_arg"
    require_source_exists "$SELECTED_SOURCE_DIR"

    if ! path_is_under_target "$full_path" "$SELECTED_TARGET_DIR"; then
        echo "Error: path must be under configured target: $SELECTED_TARGET_DIR"
        exit 1
    fi

    # Extract relative path from the target directory and convert / to # so
    # nested files can be stored flat in the selected source directory.
    relative_path=$(relative_path_from_target "$full_path" "$SELECTED_TARGET_DIR")
    dotfile_name="${relative_path//\//#}"
    dotfile_path="$SELECTED_SOURCE_DIR/$dotfile_name"

    if [ -e "$dotfile_path" ]; then
        echo "Error: $dotfile_path already exists in dotfiles"
        exit 1
    fi

    cp -R "$full_path" "$dotfile_path"
    echo "Copied $full_path -> $dotfile_path"

    read -p "Remove original at $full_path? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$full_path"
        echo "Removed $full_path"
    else
        echo "Skipped removal of $full_path"
    fi

    echo "Run dfman link --repo '$SELECTED_SOURCE_DIR' when you are ready to link it."
}

cmd_doctor() {
    local repo_arg=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)
                if [ -z "${2:-}" ]; then
                    echo "Usage: dfman doctor [--repo <source>]"
                    exit 1
                fi
                repo_arg="$2"
                shift 2
                ;;
            --repo=*)
                repo_arg="${1#--repo=}"
                if [ -z "$repo_arg" ]; then
                    echo "Usage: dfman doctor [--repo <source>]"
                    exit 1
                fi
                shift
                ;;
            *)
                echo "Usage: dfman doctor [--repo <source>]"
                exit 1
                ;;
        esac
    done

    load_config
    if [ -n "$repo_arg" ]; then
        select_config_for_repo "$repo_arg"
        require_source_exists "$SELECTED_SOURCE_DIR"
        find "$SELECTED_SOURCE_DIR" -type l ! -exec test -e {} \; -print
    else
        require_all_sources_exist

        local source_dir
        for source_dir in "${CONFIG_SOURCES[@]}"; do
            find "$source_dir" -type l ! -exec test -e {} \; -print
        done
    fi
}

cmd_repo_add() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
        echo "Usage: dfman repo-add <source> [target]"
        exit 1
    fi

    local source_arg="$1"
    local target_arg="${2:-~}"
    local source_dir
    local target_dir
    local config_dir

    validate_config_value "$source_arg" "source"
    validate_config_value "$target_arg" "target"

    source_dir=$(normalize_dir "$(expand_home "$source_arg")")
    target_dir=$(normalize_dir "$(expand_home "$target_arg")")

    validate_config_path "$source_dir" "source" "source argument"
    validate_config_path "$target_dir" "target" "target argument"

    if [ ! -d "$source_dir" ]; then
        echo "Error: source directory does not exist: $source_dir"
        exit 1
    fi

    if [ ! -d "$target_dir" ]; then
        echo "Error: target directory does not exist: $target_dir"
        exit 1
    fi

    if config_entry_exists "$source_dir" "$target_dir"; then
        echo "Source already configured: $source_arg -> $target_arg"
        return
    fi

    config_dir=$(dirname "$CONFIG_FILE")
    mkdir -p "$config_dir"

    if [ -s "$CONFIG_FILE" ] && [ -n "$(tail -c 1 "$CONFIG_FILE")" ]; then
        printf '\n' >> "$CONFIG_FILE"
    fi

    if [ "$#" -eq 2 ]; then
        printf '%s %s\n' "$source_arg" "$target_arg" >> "$CONFIG_FILE"
        echo "Added source: $source_arg -> $target_arg"
    else
        printf '%s\n' "$source_arg" >> "$CONFIG_FILE"
        echo "Added source: $source_arg -> ~"
    fi
}

cmd_repo_rm() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: dfman repo-rm <source>"
        exit 1
    fi

    local source_arg="$1"
    local source_to_remove
    local temp_file
    local line
    local stripped_line
    local line_number=0
    local source_dir
    local target_dir
    local extra
    local removed_count=0

    validate_config_value "$source_arg" "source"

    source_to_remove=$(normalize_dir "$(expand_home "$source_arg")")
    validate_config_path "$source_to_remove" "source" "source argument"

    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Error: config file not found: $CONFIG_FILE"
        exit 1
    fi

    temp_file=$(mktemp "$CONFIG_FILE.XXXXXX")

    while IFS= read -r line || [ -n "$line" ]; do
        line_number=$((line_number + 1))
        stripped_line="${line%%#*}"
        read -r source_dir target_dir extra <<< "$stripped_line"

        if [ -z "$source_dir" ]; then
            printf '%s\n' "$line" >> "$temp_file"
            continue
        fi

        if [ -n "$extra" ]; then
            rm -f "$temp_file"
            echo "Error: too many fields in $CONFIG_FILE:$line_number"
            exit 1
        fi

        source_dir=$(normalize_dir "$(expand_home "$source_dir")")
        if [ -z "$target_dir" ]; then
            target_dir="~"
        fi
        target_dir=$(normalize_dir "$(expand_home "$target_dir")")

        validate_config_path "$source_dir" "source" "$CONFIG_FILE:$line_number"
        validate_config_path "$target_dir" "target" "$CONFIG_FILE:$line_number"

        if [ "$source_dir" = "$source_to_remove" ]; then
            removed_count=$((removed_count + 1))
            continue
        fi

        printf '%s\n' "$line" >> "$temp_file"
    done < "$CONFIG_FILE"

    if [ "$removed_count" -eq 0 ]; then
        rm -f "$temp_file"
        echo "Error: repo is not configured: $source_arg"
        exit 1
    fi

    mv "$temp_file" "$CONFIG_FILE"

    if [ "$removed_count" -eq 1 ]; then
        echo "Removed source: $source_arg"
    else
        echo "Removed $removed_count sources: $source_arg"
    fi
}

# Optional reports contain only status and paths, never raw Git output or contents.
sync_report() {
    local kind="$1" detail="$2" key
    printf '%s: %s\n' "$kind" "$detail"
    if [ -n "${DFMAN_REPORT_DIR:-}" ]; then
        key=$(printf '%s' "$source_dir" | git hash-object --stdin) || return 1
        mkdir -p "$DFMAN_REPORT_DIR" || return 1
        printf '%s\n%s\n%s\n' "$kind" "$source_dir" "$detail" \
            > "$DFMAN_REPORT_DIR/$key.event.tmp" || return 1
        mv "$DFMAN_REPORT_DIR/$key.event.tmp" "$DFMAN_REPORT_DIR/$key.event" || return 1
    fi
}

# Portable lock; a stale or ownerless lock requires inspection, never stealing.
acquire_sync_lock() {
    local owner
    if ! mkdir "$lock_dir" 2>/dev/null; then
        owner=$(cat "$lock_dir/pid" 2>/dev/null) || return 1
        case "$owner" in ''|*[!0-9]*) return 1 ;; esac
        if kill -0 "$owner" 2>/dev/null; then return 75; fi
        return 1
    fi
    printf '%s\n' "$$" > "$lock_dir/pid" || {
        rmdir "$lock_dir" 2>/dev/null || true
        return 1
    }
}

sync_repo_source() (
    umask 077
    local source_dir="$1" ssh_key="${2:-}" reset="${3:-false}"
    local git_dir lock_dir branch default_ref remote_head local_head changes
    local merge_result merge_rc paths snapshot stamp recovery_ref target_tip
    local local_changes=false
    export GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true GIT_MERGE_AUTOEDIT=no

    source_dir=$(git -C "$source_dir" rev-parse --show-toplevel) || return 1
    git_dir=$(git -C "$source_dir" rev-parse --absolute-git-dir) || return 1
    lock_dir="$git_dir/dfman-sync.lock"
    if acquire_sync_lock; then
        :
    else
        merge_rc=$?
        if [ "$merge_rc" -eq 75 ]; then
            sync_report busy "Another synchronization owns the repository lock."
        else
            sync_report error "Inspect the stale or incomplete lock before removing it: $lock_dir"
        fi
        return "$merge_rc"
    fi
    trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    echo "Syncing repo: $source_dir"

    # Do this before add -A, including in reset mode. An interrupted manual Git
    # operation belongs to its user, and must not become an automatic commit.
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer; do
        if [ -e "$git_dir/$marker" ]; then
            sync_report conflict "Finish or abort the existing Git operation ($marker) before syncing."
            return 2
        fi
    done
    paths=$(git -C "$source_dir" diff --name-only --diff-filter=U) || return 1
    if [ -n "$paths" ]; then
        sync_report conflict "Resolve the existing conflicts before syncing:
$paths"
        return 2
    fi
    # Nested working trees need their own preservation policy; don't pretend an
    # outer repository snapshot safely synchronizes submodule working state.
    if [ -s "$source_dir/.gitmodules" ]; then
        sync_report error "Repositories with submodules require manual synchronization."
        return 1
    fi
    local_head=$(git -C "$source_dir" rev-parse --verify HEAD) || return 1

    if [ "$reset" = true ]; then
        default_ref=$(git_remote "$source_dir" "$ssh_key" ls-remote --symref origin HEAD) || {
            sync_report error "Cannot read the remote default branch. Local files were not reset."
            return 1
        }
        branch=$(printf '%s\n' "$default_ref" | awk '$1 == "ref:" && $3 == "HEAD" {
            sub("^refs/heads/", "", $2); print $2; exit
        }')
        if [ -z "$branch" ]; then
            sync_report error "The remote has no advertised default branch. Local files were not reset."
            return 1
        fi
    else
        branch=$(git -C "$source_dir" symbolic-ref --quiet --short HEAD) || {
            sync_report error "Select a local branch before syncing."
            return 1
        }
    fi
    if ! git_remote "$source_dir" "$ssh_key" fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch"; then
        sync_report error "Cannot fetch remote updates. Local files were not changed."
        return 1
    fi
    remote_head=$(git -C "$source_dir" rev-parse "refs/remotes/origin/$branch") || return 1

    if [ "$reset" = true ]; then
        changes=$(git -C "$source_dir" status --porcelain --untracked-files=all) || return 1
        target_tip=$(git -C "$source_dir" rev-parse --verify "refs/heads/$branch" 2>/dev/null) || target_tip=""
        if [ -n "$changes" ] || ! git -C "$source_dir" merge-base --is-ancestor "$local_head" "$remote_head"; then
            local_changes=true
        fi
        if [ -n "$target_tip" ] && ! git -C "$source_dir" merge-base --is-ancestor "$target_tip" "$remote_head"; then
            local_changes=true
        fi
        if [ "$local_head" = "$remote_head" ] && [ -z "$changes" ] && \
            [ "$(git -C "$source_dir" symbolic-ref --quiet --short HEAD)" = "$branch" ]; then
            sync_report ok "Already matches origin/$branch."
            return 0
        fi
        # Archive the actual working tree, including ignored files. reset --hard
        # can overwrite ignored paths if a remote adds a tracked file there.
        # Keep snapshots inside .git, outside both cleanup and dotfile linking.
        stamp="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
        snapshot="$git_dir/dfman-recovery/$stamp"
        recovery_ref="refs/dfman/recovery/$stamp"
        mkdir -p "$snapshot" || return 1
        if ! tar -cf "$snapshot/files.tar" --exclude='./.git' -C "$source_dir" . || \
            ! tar -tf "$snapshot/files.tar" >/dev/null; then
            sync_report error "Backup failed. Local files were not reset. Incomplete backup: $snapshot"
            return 1
        fi
        if [ -f "$git_dir/index" ]; then
            cp "$git_dir/index" "$snapshot/index" || return 1
        fi
        git -C "$source_dir" update-ref "$recovery_ref/head" "$local_head" || return 1
        if [ -n "$target_tip" ]; then
            git -C "$source_dir" update-ref "$recovery_ref/branch" "$target_tip" || return 1
        fi
        printf 'Repository: %s\nHEAD: %s\nTarget: %s\nRecovery ref: %s/head\n' \
            "$source_dir" "$local_head" "$remote_head" "$recovery_ref" > "$snapshot/README" || return 1
        # A durable event is written before deletion, so failed resets can still
        # be traced to their backup. It is also consumed after interrupted runs.
        if [ "$local_changes" = true ]; then
            printf 'Local differences saved before resetting to origin/%s.\nBackup: %s\n' \
                "$branch" "$snapshot" > "$snapshot/notice.pending" || return 1
        fi
        echo "Recovery snapshot: $snapshot ($recovery_ref/head)"
        if ! git -C "$source_dir" reset --hard || \
            ! git -C "$source_dir" clean -fd || \
            ! git -C "$source_dir" checkout --no-overwrite-ignore -B "$branch" "origin/$branch"; then
            sync_report error "Reset did not complete. Recover local files from: $snapshot"
            return 1
        fi
        sync_report ok "Reset to origin/$branch. Recovery snapshot: $snapshot"
        return 0
    fi

    git -C "$source_dir" add -A || return 1
    if git -C "$source_dir" diff --cached --quiet; then
        echo "No local changes to commit"
    else
        merge_rc=$?
        [ "$merge_rc" -eq 1 ] || return 1
        if ! git -C "$source_dir" commit -m "sync by $(hostname) at $(date '+%Y-%m-%d %H:%M:%S')"; then
            sync_report error "Cannot commit local changes. They remain in the repository."
            return 1
        fi
    fi
    local_head=$(git -C "$source_dir" rev-parse HEAD) || return 1
    # merge-tree computes conflicts in Git's object store, never in the checkout
    # behind active home-directory symlinks. Requires Git 2.38 or newer.
    if ! git -C "$source_dir" merge-base --is-ancestor "$remote_head" "$local_head"; then
        if merge_result=$(git -C "$source_dir" merge-tree --write-tree --name-only "$local_head" "$remote_head"); then
            :
        else
            merge_rc=$?
            if [ "$merge_rc" -eq 1 ]; then
                paths=$(printf '%s\n' "$merge_result" | awk 'NR == 1 { next } /^$/ { exit } { print }')
                sync_report conflict "Local work is saved; remote updates conflict with:
$paths
Local commit: $local_head
Remote commit: $remote_head"
                return 2
            fi
            sync_report error "Cannot prepare the merge. Local files were not merged; Git 2.38 or newer is required."
            return 1
        fi
        if ! git -C "$source_dir" merge --no-edit --no-stat --no-autostash "$remote_head"; then
            if [ -e "$git_dir/MERGE_HEAD" ] && ! git -C "$source_dir" merge --abort; then
                sync_report conflict "Cannot abort the interrupted merge. Resolve it manually before syncing."
                return 2
            fi
            sync_report error "Cannot apply remote updates. Local work is preserved."
            return 1
        fi
    fi
    if ! git_remote "$source_dir" "$ssh_key" push origin "HEAD:refs/heads/$branch"; then
        sync_report error "Cannot publish local commits. They are preserved; synchronization will retry."
        return 1
    fi
    sync_report ok "Synchronized with origin/$branch."
)

build_git_ssh_command() {
    local ssh_key="$1"
    local quoted_ssh_key

    printf -v quoted_ssh_key "%q" "$ssh_key"
    printf "ssh -i %s -o IdentitiesOnly=yes" "$quoted_ssh_key"
}

git_remote() {
    local source_dir="$1"
    local ssh_key="$2"

    shift 2

    if [ -n "$ssh_key" ]; then
        GIT_SSH_COMMAND="$(build_git_ssh_command "$ssh_key")" git -C "$source_dir" "$@"
    else
        git -C "$source_dir" "$@"
    fi
}

cmd_repo_sync() {
    local repo_arg=""
    local ssh_key_arg=""
    local reset=false
    local result=0
    local rc=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --reset)
                reset=true
                shift
                ;;
            --repo)
                if [ -z "${2:-}" ]; then
                    repo_sync_usage
                    exit 1
                fi
                repo_arg="$2"
                shift 2
                ;;
            --repo=*)
                repo_arg="${1#--repo=}"
                if [ -z "$repo_arg" ]; then
                    repo_sync_usage
                    exit 1
                fi
                shift
                ;;
            --ssh-key)
                if [ -z "${2:-}" ]; then
                    repo_sync_usage
                    exit 1
                fi
                ssh_key_arg=$(expand_home "$2")
                shift 2
                ;;
            --ssh-key=*)
                ssh_key_arg="${1#--ssh-key=}"
                if [ -z "$ssh_key_arg" ]; then
                    repo_sync_usage
                    exit 1
                fi
                ssh_key_arg=$(expand_home "$ssh_key_arg")
                shift
                ;;
            *)
                repo_sync_usage
                exit 1
                ;;
        esac
    done

    if [ -n "$ssh_key_arg" ] && { [ ! -f "$ssh_key_arg" ] || [ ! -r "$ssh_key_arg" ]; }; then
        echo "Error: SSH key does not exist or is not readable: $ssh_key_arg"
        exit 1
    fi

    load_config
    if [ -n "$repo_arg" ]; then
        select_config_for_repo "$repo_arg"
        sync_repo_source "$SELECTED_SOURCE_DIR" "$ssh_key_arg" "$reset" && return 0
        return $?
    fi

    # Sync all repos in parallel. Each job writes to its own log file so the
    # output of concurrent syncs is printed grouped per repo, not interleaved.
    local index
    local log_dir
    local pids=()

    log_dir=$(mktemp -d)

    for index in "${!CONFIG_SOURCES[@]}"; do
        sync_repo_source "${CONFIG_SOURCES[$index]}" "$ssh_key_arg" "$reset" \
            > "$log_dir/$index.log" 2>&1 &
        pids+=("$!")
    done

    for index in "${!pids[@]}"; do
        if wait "${pids[$index]}"; then
            rc=0
        else
            rc=$?
            case "$rc" in
                2) result=2 ;;
                75) [ "$result" -ne 0 ] || result=75 ;;
                *) [ "$result" -eq 2 ] || result=1 ;;
            esac
        fi
        cat "$log_dir/$index.log"
    done

    rm -rf "$log_dir"

    return "$result"
}

cmd_status() (
    local mode="${1:-}" state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dfman"
    local report kind repo detail problems="" summary="" owner last_run="not recorded"
    case "$mode" in ''|--prompt|--ack) ;; *) echo "Usage: dfman status [--prompt|--ack]"; return 1 ;; esac
    [ "$#" -le 1 ] || { echo "Usage: dfman status [--prompt|--ack]"; return 1; }
    shopt -s nullglob
    if [ "$mode" = --ack ]; then
        # Acknowledge backup notices only. Actual failures clear after recovery.
        for report in "$state_dir"/notices/*.event; do rm -f "$report" || return 1; done
    fi
    for report in "$state_dir"/reports/*.event "$state_dir"/notices/*.event; do
        kind=$(sed -n '1p' "$report")
        repo=$(sed -n '2p' "$report")
        detail=$(sed -n '3,$p' "$report")
        summary="${summary}${repo}: ${kind}
${detail}

"
        case "$kind" in
            ok|busy) ;;
            *) problems="${problems}${repo}: ${kind}
${detail}

" ;;
        esac
    done
    if [ -d "$state_dir/runner.lock" ]; then
        owner=$(cat "$state_dir/runner.lock/pid" 2>/dev/null) || owner=""
        case "$owner" in
            ''|*[!0-9]*) owner="" ;;
        esac
        if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
            detail="Inspect the interrupted runner lock before removing it: $state_dir/runner.lock"
            problems="${problems}${detail}
"
            summary="${summary}${detail}
"
        fi
    fi
    if [ "$mode" = --prompt ]; then
        [ -n "$problems" ] || return 0
        printf '%s' "$problems" | git hash-object --stdin || return 1
        printf 'dfman: synchronization needs attention.\n'
        printf '%s' "$problems" | LC_ALL=C tr -d '\000-\010\013-\037\177' | head -n 8
        printf '%s\n' 'Run dfman status for full details.'
        return 0
    fi
    [ ! -f "$state_dir/last-run" ] || last_run=$(cat "$state_dir/last-run")
    printf 'Last scheduled run: %s\nLog: %s/sync.log\n\n' "$last_run" "$state_dir"
    if [ -n "$summary" ]; then
        # Paths from Git are data: never interpret terminal control characters.
        printf '%s' "$summary" | LC_ALL=C tr -d '\000-\010\013-\037\177'
    else
        echo "No scheduled synchronization results recorded yet."
    fi
    if [ -n "$problems" ]; then
        echo "Backup notices can be acknowledged with dfman status --ack. Conflicts require resolution."
    fi
)

# Status only schedules a bounded background check when the six-hour cache is
# due. No network request is awaited by a prompt, and updates are never applied.
update_check_due() {
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dfman" checked now
    checked=$(cat "$state_dir/update-attempt" 2>/dev/null) || checked=0
    case "$checked" in ''|*[!0-9]*) checked=0 ;; esac
    now=$(date +%s)
    [ "$now" -lt "$checked" ] || [ "$((now - checked))" -ge 21600 ]
}

check_update() (
    umask 077
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dfman" script_path download_dir first_line
    mkdir -p "$state_dir" || return 1
    mkdir "$state_dir/update-check.lock" 2>/dev/null || return 0
    download_dir=""
    trap '[ -z "$download_dir" ] || rm -rf "$download_dir"; rmdir "$state_dir/update-check.lock" 2>/dev/null || true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    date +%s > "$state_dir/update-attempt" || return 1
    download_dir=$(mktemp -d "$state_dir/update.XXXXXX") || return 1
    script_path=$(current_executable_path) || return 1
    if ! download_update "$download_dir/dfman"; then
        echo "Cannot check for updates. The installed version was not changed."
        return 1
    fi
    read -r first_line < "$download_dir/dfman" || true
    if [ "$first_line" != '#!/bin/bash' ] || ! bash -n "$download_dir/dfman"; then
        echo "The published script is invalid. The installed version was not changed."
        return 1
    fi
    {
        git hash-object "$script_path" && git hash-object "$download_dir/dfman"
    } > "$download_dir/result" || return 1
    mv "$download_dir/result" "$state_dir/update-result" || return 1
    if cmp -s "$script_path" "$download_dir/dfman"; then
        echo "dfman is up to date."
    else
        echo "A different published version is available. Run dfman self-update to install it."
    fi
)

shell_status() {
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dfman" script_path notice local_hash checked_hash published_hash
    script_path=$(current_executable_path) || return 1
    if update_check_due && [ ! -d "$state_dir/update-check.lock" ]; then
        "$script_path" self-update --check --cached </dev/null >/dev/null 2>&1 &
    fi
    notice=$(cmd_status --prompt) || return 1
    if [ -n "$notice" ]; then
        # cmd_status emits a fingerprint followed by the useful problem details.
        printf '%s\n' "$notice" | sed '1d'
    fi
    if [ -f "$state_dir/update-result" ]; then
        checked_hash=$(sed -n '1p' "$state_dir/update-result")
        published_hash=$(sed -n '2p' "$state_dir/update-result")
        local_hash=$(git hash-object "$script_path") || return 1
        # A successful update or local edit invalidates a result for the old file.
        if [ "$local_hash" = "$checked_hash" ] && [ "$local_hash" != "$published_hash" ]; then
            echo "dfman: the published version differs. Run dfman self-update to install it."
        fi
    fi
}

shell_init() {
    cat <<'HOOK'
[[ -o interactive ]] || return 0
_dfman_prompt_notice() {
    local previous_rc=$? notice
    [[ -t 1 ]] || return "$previous_rc"
    (( $+commands[dfman] )) || return "$previous_rc"
    notice=$(command dfman shell status 2>/dev/null) || return "$previous_rc"
    if [[ "$notice" != "${_dfman_seen_notice:-}" ]]; then
        [[ -z "$notice" ]] || print -r -- "$notice"
        _dfman_seen_notice=$notice
    fi
    return "$previous_rc"
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _dfman_prompt_notice
HOOK
}

shell_install() (
    local action="$1" rc_file rc_source temp_dir label
    if [ "$action" = install ]; then label=installed; else label=uninstalled; fi
    rc_file="${ZDOTDIR:-$HOME}/.zshrc"
    rc_source=$(current_executable_path "$rc_file") || return 1
    [ ! -e "$rc_source" ] || [ -f "$rc_source" ] || { echo "Not a regular shell configuration: $rc_source"; return 1; }
    temp_dir=$(mktemp -d) || return 1
    trap 'rm -rf "$temp_dir"' EXIT
    # Only remove our delimited block and the exact previous manual integration.
    # Refuse malformed markers rather than accidentally removing other settings.
    if [ -f "$rc_source" ]; then
        awk '
            $0 == "# >>> dfman shell >>>" { if (inside) exit 2; inside=1; next }
            $0 == "# <<< dfman shell <<<" { if (!inside) exit 2; inside=0; next }
            inside { next }
            $0 == "# Show unresolved scheduled dotfile sync problems at the next prompt." { next }
            $0 == "[[ ! -r \"$HOME/.local/share/dfman/dfman.zsh\" ]] || source \"$HOME/.local/share/dfman/dfman.zsh\"" { next }
            { print }
            END { if (inside) exit 2 }
        ' "$rc_source" > "$temp_dir/rc" || { echo "Check the existing dfman markers in $rc_source before retrying."; return 1; }
    else
        : > "$temp_dir/rc"
    fi
    if [ "$action" = install ]; then
        cat >> "$temp_dir/rc" <<'BLOCK'
# >>> dfman shell >>>
if command -v dfman >/dev/null 2>&1; then
  eval "$(dfman shell init zsh)"
fi
# <<< dfman shell <<<
BLOCK
    fi
    zsh -n "$temp_dir/rc" || return 1
    if [ -f "$rc_source" ] && cmp -s "$temp_dir/rc" "$rc_source"; then
        echo "Shell integration is already $label: $rc_file"
        return 0
    fi
    # Write the resolved source, preserving the shell configuration symlink,
    # ownership and existing permissions (including dfman-managed dotfiles).
    cat "$temp_dir/rc" > "$rc_source" || return 1
    echo "Shell integration $label in $rc_file (source: $rc_source)."
    if [ "$action" = install ]; then
        echo 'Open a new terminal, or run: eval "$(dfman shell init zsh)"'
    else
        echo 'Existing terminals: add-zsh-hook -d precmd _dfman_prompt_notice'
    fi
)

cmd_shell() {
    local action="${1:-}" selected_shell="${2:-${SHELL##*/}}"
    [ "$#" -le 2 ] || { echo "Usage: dfman shell <install|uninstall|init|status> [zsh]"; return 1; }
    case "$action" in
        status) [ "$#" -eq 1 ] || return 1; shell_status ;;
        install|uninstall|init)
            if [ "$selected_shell" != zsh ]; then
                echo "Automatic shell integration currently supports zsh. Run dfman shell $action zsh explicitly, or use dfman shell status directly."
                return 1
            fi
            if [ "$action" = init ]; then shell_init; else shell_install "$action"; fi
            ;;
        *) echo "Usage: dfman shell <install|uninstall|init|status> [zsh]"; return 1 ;;
    esac
}

cmd_self_update() {
    if [ "${1:-}" = --check ]; then
        [ "$#" -le 2 ] && { [ "$#" -eq 1 ] || [ "$2" = --cached ]; } || return 1
        if [ "${2:-}" = --cached ] && ! update_check_due; then return 0; fi
        check_update
        return $?
    fi
    [ "$#" -eq 0 ] || { echo "Usage: dfman self-update [--check]"; return 1; }
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo "Error: curl or wget is required for self-update"
        exit 1
    fi

    local script_path
    local temp_dir
    local temp_file
    local first_line

    script_path=$(current_executable_path)
    temp_dir=$(mktemp -d)
    temp_file="$temp_dir/dfman"

    if ! download_update "$temp_file"; then
        rm -rf "$temp_dir"
        echo "Error: failed to download dfman from $DFMAN_UPDATE_URL"
        exit 1
    fi

    read -r first_line < "$temp_file" || true
    if [ ! -s "$temp_file" ] || [ "$first_line" != "#!/bin/bash" ]; then
        rm -rf "$temp_dir"
        echo "Error: downloaded update does not look like dfman"
        exit 1
    fi

    if cmp -s "$temp_file" "$script_path"; then
        rm -rf "$temp_dir"
        echo "dfman is already up to date"
        return
    fi

    if ! install -m 0755 "$temp_file" "$script_path"; then
        rm -rf "$temp_dir"
        echo "Error: failed to install update to $script_path"
        exit 1
    fi

    rm -rf "$temp_dir"
    echo "Updated dfman at $script_path"
}

download_update() {
    # Resolve the published commit first: raw/main can serve stale contents even
    # after a successful push. Both checks and installs use the immutable URL.
    local revision update_url
    local revision_url="https://api.github.com/repos/kopiro/dfman/commits/main?dfman=$(date +%s)"
    if command -v curl >/dev/null 2>&1; then
        revision=$(curl -fsSL --connect-timeout 5 --max-time 15 \
            -H 'Accept: application/vnd.github.sha' "$revision_url") || return 1
    else
        revision=$(wget -q --timeout=15 --tries=1 \
            --header='Accept: application/vnd.github.sha' -O - "$revision_url") || return 1
    fi
    if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
        echo "Cannot resolve the published dfman commit." >&2
        return 1
    fi
    update_url="https://raw.githubusercontent.com/kopiro/dfman/$revision/dfman"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 5 --max-time 15 -o "$1" "$update_url"
    else
        wget -q --timeout=15 --tries=1 -O "$1" "$update_url"
    fi
}

case "${1:-}" in
    link)
        shift
        cmd_link "$@"
        ;;
    create)
        shift
        cmd_create "$@"
        ;;
    doctor)
        shift
        cmd_doctor "$@"
        ;;
    repo-add)
        shift
        cmd_repo_add "$@"
        ;;
    repo-rm)
        shift
        cmd_repo_rm "$@"
        ;;
    repo-sync|sync)
        shift
        cmd_repo_sync "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    shell)
        shift
        cmd_shell "$@"
        ;;
    self-update)
        shift
        cmd_self_update "$@"
        ;;
    -h|--help)
        usage
        ;;
    "")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        ;;
esac
